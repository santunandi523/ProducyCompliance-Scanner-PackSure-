# ========================================================
# PackSure Frontend Environment Configuration
# ========================================================
# For Vercel deployment: Set VITE_API_BASE_URL to your public backend API URL.
# Examples:
#   VITE_API_BASE_URL=https://api.yourdomain.com/api
#   VITE_API_BASE_URL=https://packsure-backend.onrender.com/api
# In local development, it defaults to http://localhost:8081/api
VITE_API_BASE_URL=http://localhost:8081/api
